{
  "expo": {
    "name": "ABCDE Method",
    "slug": "abcde-method",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/abcde-app-icon.png",
    "scheme": "abcdemethod",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.oke225.abcdemethod"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/abcde-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/abcde-app-icon.png",
          "imageWidth": 225,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14",
          "dark": {
            "backgroundColor": "#0B0F14"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d24d639-14b8-4c3b-b793-4934c62b43b8"
      }
    }
  }
}
